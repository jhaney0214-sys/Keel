__pycache__/
*.py[cod]
# Reports are generated by `python -m keel run`; they are outputs, not source.
examples/*/report/
# A real credit union's files must never be committed. Keep them outside this
# folder, or here, where git ignores them.
private/
# The three generated credit unions: rebuilt identically by
# `python tools/make_samples.py` (fixed seeds), and 11 MB between them.
examples/small-cu/
examples/mid-cu/
examples/large-cu/
# Run history is written by every report; the back-test sample regenerates its own.
examples/*/history/
